{
  // Debian-configs (RDEB) — fastfetch, migrado do neofetch em 2026-10-12.
  // Replica: ascii_distro="Linux" (pinguim) + ascii_colors=(7 1 3 7 1 3)
  // e os 17 módulos do print_info do configs/neofetch/config.conf
  // (mantido em transição; ver ROADMAP P1-1).
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "linux",
    "color": {
      "1": "white",
      "2": "red",
      "3": "yellow",
      "4": "white",
      "5": "red",
      "6": "yellow"
    }
  },
  "display": {
    "separator": ": "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "colors"
  ]
}
